#!/bin/sh
# opnsense-pi boot hook. Runs from /etc/rc in the "import" stage: / is writable,
# nothing is configured yet, and the configuration importer (20-importer) and
# the interface setup come after it.
#
# Everything is driven by files in opnsense-pi/ on the FAT EFI partition, so it
# can be set up from any computer after flashing (or by a netboot installer):
#
#   config.xml            installed as /conf/config.xml once, then renamed to
#                         config.xml.applied (the old config is kept in
#                         /conf/backup/)
#   drivers               "auto" (default), "force" or "off": whether to load
#                         this board's extra kernel modules (see below)
#   ifnames               "<mac> <name>" lines: give those NICs those names
#                         (see pin_ifnames below); copied to
#                         /usr/local/etc/opnsense-pi/ifnames on every boot
#   reboot-after-minutes  a number: reboot that many minutes after every boot.
#                         A safety net for remote installs; delete it to stop.
#                         Such trial boots also save diagnostics snapshots
#                         (opnsense-pi-diag) to opnsense-pi/diag-*.txt.
#
# Extra kernel modules (e.g. Pi 5 RP1 Ethernet) are listed in
# /usr/local/etc/opnsense-pi/board.conf. They poke the board's hardware
# directly when loaded, so "auto" only loads them when SMBIOS names the board.
#
# On arm64 a config whose Suricata pattern matcher is Hyperscan (MPMAlgo "hs",
# x86 only, common in configs moved from an x86 box) is switched to "ac", or
# Suricata would not start.

LOG=/var/log/opnsense-pi.log
log() {
	echo "opnsense-pi: $*"
	mkdir -p /var/log && echo "$(date '+%Y-%m-%dT%H:%M:%S') $*" >> ${LOG}
}

IFNAMES=/usr/local/etc/opnsense-pi/ifnames
BOARD='' BOARD_MATCH='' KMODS_LOAD=''
[ -f /usr/local/etc/opnsense-pi/board.conf ] && . /usr/local/etc/opnsense-pi/board.conf

esp=$(gpart show -p 2>/dev/null | awk '$4 == "efi" { print "/dev/" $3; exit }')
drivers=auto trial=
# The image's fstab mounts the ESP (/dev/gpt/efifs) on /boot/efi before this
# runs; use that mount if it is there, else mount the ESP ourselves.
mnt=$(mount -p 2>/dev/null | awk '$2 == "/boot/efi" && $3 == "msdosfs" { print $2; exit }')
own_mnt=
if [ -z "${mnt}" ] && [ -n "${esp}" ]; then
	mnt=/tmp/.opnsense-pi-esp
	if mkdir -p ${mnt} && mount_msdosfs ${esp} ${mnt}; then
		own_mnt=1
	else
		log "could not mount the EFI partition ${esp}"
		mnt=
	fi
fi
[ -n "${mnt}" ] || [ -n "${esp}" ] || log "no EFI partition found"
if [ -n "${mnt}" ]; then
	esp="${esp:-ESP} (${mnt})"
	dir=${mnt}/opnsense-pi
	if [ -f ${dir}/config.xml ]; then
		mkdir -p /conf/backup
		[ -f /conf/config.xml ] && cp /conf/config.xml "/conf/backup/config-opnsense-pi-$(date +%s).xml"
		if cp ${dir}/config.xml /conf/config.xml.new && mv /conf/config.xml.new /conf/config.xml; then
			mv ${dir}/config.xml ${dir}/config.xml.applied
			log "installed config.xml from ${esp}"
		else
			log "could not install config.xml from ${esp}"
		fi
	fi
	if [ -f ${dir}/ifnames ]; then
		mkdir -p ${IFNAMES%/*}
		tr -d '\r' < ${dir}/ifnames > ${IFNAMES} && log "using ifnames from ${esp}"
	fi
	[ -f ${dir}/drivers ] && drivers=$(tr -cd 'a-z' < ${dir}/drivers)
	if [ -f ${dir}/reboot-after-minutes ]; then
		mins=$(tr -cd '0-9' < ${dir}/reboot-after-minutes)
		if [ -n "${mins}" ] && [ "${mins}" -gt 0 ]; then
			log "reboot-after-minutes: rebooting in ${mins} minutes"
			trial=1
			# Diagnostics snapshots on the ESP (opnsense-pi-diag): "boot" at the
			# end of this hook, "running" once the system is up (when there is
			# time for it), "reboot" just before rebooting.
			secs=$((mins * 60)) first=0
			[ ${secs} -gt 300 ] && first=180
			diag=/usr/local/sbin/opnsense-pi-diag
			daemon -f sh -c "sleep ${first}; [ ${first} = 0 ] || ${diag} running; sleep $((secs - first)); ${diag} reboot; echo \"\$(date '+%Y-%m-%dT%H:%M:%S') reboot-after-minutes: rebooting\" >> ${LOG}; /sbin/shutdown -r now"
		fi
	fi
	[ -n "${own_mnt}" ] && umount ${mnt}
fi

if [ -n "${KMODS_LOAD}" ]; then
	product=$(kenv -q smbios.system.product)
	case "${drivers}" in
	off)
		load='' why="disabled by opnsense-pi/drivers" ;;
	force)
		load=1 why="forced by opnsense-pi/drivers" ;;
	*)
		case "${product}" in
		*"${BOARD_MATCH}"*) load=1 why="SMBIOS product '${product}'" ;;
		*) load='' why="SMBIOS product is '${product:-unknown}', not '${BOARD_MATCH}'" ;;
		esac ;;
	esac
	if [ -n "${load}" ]; then
		log "loading ${KMODS_LOAD} (${why})"
		for k in ${KMODS_LOAD}; do
			kldstat -qm ${k} || kldload ${k} || log "kldload ${k} failed"
		done
	else
		log "not loading ${BOARD} modules ${KMODS_LOAD}: ${why}"
	fi
fi

# Interface names by MAC address. USB NICs (ue0, ue1, ...) are named in the
# order their USB controllers finish attaching, which can change from one boot
# to the next, so with two of them the LAN and WAN (say) can swap. IFNAMES
# holds "<mac> <name>" lines; matching NICs are renamed before OPNsense sets up
# any interface. Without the file, the first boot that finds USB NICs records
# their MACs and names, and later boots keep those names.
mac_of() { ifconfig "$1" ether 2>/dev/null | awk '$1 == "ether" { print $2; exit }'; }
if_with_mac() {
	for i in $(ifconfig -l ether); do
		[ "$(mac_of ${i})" = "$1" ] && { echo ${i}; return; }
	done
}
usb_nics() { ifconfig -l ether | tr ' ' '\n' | grep -E '^ue[0-9]+$'; }
pin_ifnames() {
	if [ ! -f ${IFNAMES} ]; then
		# Let the USB NICs finish attaching (the list stops changing).
		prev= n=0
		while [ ${n} -lt 10 ]; do
			cur=$(usb_nics | tr '\n' ' ')
			[ -n "${cur}" ] && [ "${cur}" = "${prev}" ] && break
			prev=${cur}; n=$((n + 1)); sleep 1
		done
		[ -n "$(usb_nics)" ] || return 0
		mkdir -p ${IFNAMES%/*}
		{
			echo "# <mac> <name>: interface names pinned by opnsense-pi (see 10-opnsense-pi)"
			for i in $(usb_nics); do echo "$(mac_of ${i}) ${i}"; done
		} > ${IFNAMES}
		log "recorded USB NIC names: $(grep -v '^#' ${IFNAMES} | tr '\n' ' ')"
		return 0
	fi
	pins=$(awk '!/^[[:space:]]*(#|$)/ && NF >= 2 { print tolower($1) "=" $2 }' ${IFNAMES})
	[ -n "${pins}" ] || return 0
	# Wait up to 15 s for every listed NIC to appear.
	n=0
	while [ ${n} -lt 15 ]; do
		missing=
		for p in ${pins}; do [ -n "$(if_with_mac ${p%%=*})" ] || missing=1; done
		[ -z "${missing}" ] && break
		n=$((n + 1)); sleep 1
	done
	# Two passes through temporary names, so names can be swapped.
	k=0 moved=
	for p in ${pins}; do
		mac=${p%%=*}
		want=${p#*=}
		cur=$(if_with_mac ${mac})
		[ -n "${cur}" ] || { log "pin_ifnames: no NIC with MAC ${mac} (for ${want})"; continue; }
		[ "${cur}" = "${want}" ] && continue
		ifconfig ${cur} name pin${k} >/dev/null && moved="${moved} pin${k}=${want}=${cur}"
		k=$((k + 1))
	done
	for m in ${moved}; do
		tmp=${m%%=*}
		rest=${m#*=}
		want=${rest%%=*}
		was=${rest#*=}
		if ifconfig -l | tr ' ' '\n' | grep -qx "${want}"; then
			log "pin_ifnames: ${want} is taken by another NIC; keeping ${was}"
			ifconfig ${tmp} name ${was} >/dev/null
		elif ifconfig ${tmp} name ${want} >/dev/null; then
			log "pin_ifnames: ${was} -> ${want}"
		fi
	done
}
pin_ifnames

case "$(uname -p)" in
aarch64|arm64)
	if grep -q '<MPMAlgo>hs</MPMAlgo>' /conf/config.xml 2>/dev/null; then
		sed -i '' 's|<MPMAlgo>hs</MPMAlgo>|<MPMAlgo>ac</MPMAlgo>|' /conf/config.xml &&
			log "Suricata: switched MPMAlgo hs (Hyperscan is x86 only) to ac"
	fi ;;
esac

[ -n "${trial}" ] && /usr/local/sbin/opnsense-pi-diag boot

exit 0
