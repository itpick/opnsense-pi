# Pinned inputs. Bump a version and its sha256 together.

OPNSENSE_VERSION=26.7

# Community aarch64 VM images (unofficial): https://github.com/maurice-w/opnsense-vm-images
# "efi" = console on the EFI framebuffer (HDMI) -> used for the Pi images.
# "serial" = console on the UART -> used by the VM tests (vm/), which drive it over a socket.
OPNSENSE_EFI_URL=https://github.com/maurice-w/opnsense-vm-images/releases/download/26.7/OPNsense-26.7-ufs-efi-vm-aarch64.qcow2.bz2
OPNSENSE_EFI_SHA256=bb1868bf63ae29cd124538901a8c803fcd2ea35e1d092331a3b6845cf12f7e2b
OPNSENSE_SERIAL_URL=https://github.com/maurice-w/opnsense-vm-images/releases/download/26.7/OPNsense-26.7-ufs-serial-vm-aarch64.qcow2.bz2
OPNSENSE_SERIAL_SHA256=564a17e61855822bdede24ad06fcdc5883d283426c4da5d3d977efe056a4ebe6

# Raspberry Pi 4 UEFI firmware: https://github.com/pftf/RPi4
RPI4_FW_URL=https://github.com/pftf/RPi4/releases/download/v1.53/RPi4_UEFI_Firmware_v1.53.zip
RPI4_FW_SHA256=ca9973e2a7a546b3df871cfb7382e656829114b6dfa424f40dc67cc90a217d88

# Raspberry Pi 5 UEFI firmware, D0 stepping (all 2GB/16GB boards, most late-2024+ boards):
# https://github.com/NumberOneGit/rpi5-uefi
RPI5_FW_URL=https://github.com/NumberOneGit/rpi5-uefi/releases/download/v0.1/RPI5_D0.zip
RPI5_FW_SHA256=c4fbbec9cd0d1115c9adab884923061b960de42b4ca6d65ba5f08cb6b46c6fad

# --- Bundled drivers (added by scripts/customize.sh on FreeBSD; see README) ---

# Kernel sources the Pi 5 modules are compiled against. They must match the
# image's kernel: OPNsense's src at the image's version, kernel config SMP-ARM
# (the community images' PRODUCT_KERNEL), taken from opnsense/tools.
OPNSENSE_SRC_REPO=https://github.com/opnsense/src
OPNSENSE_SRC_REF=26.7
OPNSENSE_TOOLS_REF=26.7
OPNSENSE_KERNCONF=SMP-ARM

# Raspberry Pi 5 kernel modules (RP1 Ethernet, fan): https://github.com/aphor/FreeBSD15-RPi5-modules
# bcm2712_pcie and bcm2712 are dependencies of rp1_eth and rpi5.
RPI5_KMODS_REPO=https://github.com/aphor/FreeBSD15-RPi5-modules
RPI5_KMODS_REV=ecacf2bf73d15008dbd86dfd3580e51c67a8a08a
RPI5_KMODS_BUILD="bcm2712 bcm2712_pcie rp1_eth rpi5"
RPI5_KMODS_LOAD="rp1_eth rpi5"

# OPNsense plugins preinstalled in both images (from the image's own package repo).
PLUGINS="os-realtek-re"
