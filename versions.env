# Pinned inputs. Bump a version and its sha256 together.

OPNSENSE_VERSION=26.7

# Community aarch64 VM images (unofficial): https://github.com/maurice-w/opnsense-vm-images
# "efi" = console on the EFI framebuffer (HDMI) -> used for the Pi images.
# "serial" = console on the UART -> used by the VM tests (vm/), which drive it over a socket.
OPNSENSE_EFI_URL=https://github.com/maurice-w/opnsense-vm-images/releases/download/26.7/OPNsense-26.7-ufs-efi-vm-aarch64.qcow2.bz2
OPNSENSE_EFI_SHA256=bb1868bf63ae29cd124538901a8c803fcd2ea35e1d092331a3b6845cf12f7e2b
OPNSENSE_SERIAL_URL=https://github.com/maurice-w/opnsense-vm-images/releases/download/26.7/OPNsense-26.7-ufs-serial-vm-aarch64.qcow2.bz2
OPNSENSE_SERIAL_SHA256=564a17e61855822bdede24ad06fcdc5883d283426c4da5d3d977efe056a4ebe6

